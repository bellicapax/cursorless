{
  "name": "@cursorless/cursorless-jetbrains",
  "version": "1.0.0",
  "description": "cursorless in jetbrains",
  "main": "./out/cursorless.js",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "pnpm run esbuild:prod && pnpm run populate-dist",
    "esbuild:base": "esbuild ./src/index.ts --format=esm --target=es2020 --bundle --main-fields=main,module --outfile=./out/cursorless.js --platform=neutral --external:std --external:module --external:fs --external:path",
    "esbuild": "pnpm run esbuild:base --sourcemap",
    "esbuild:prod": "pnpm run esbuild:base --minify",
    "populate-dist": "bash ./scripts/populate-dist.sh",
    "clean": "rm -rf ./out ./dist ./tsconfig.tsbuildinfo"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@cursorless/lib-common": "workspace:*",
    "@cursorless/lib-engine": "workspace:*",
    "@cursorless/lib-test-case-recorder": "workspace:*",
    "lodash-es": "^4.17.21",
    "vscode-uri": "^3.1.0",
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/lodash-es": "4.17.12"
  }
}
